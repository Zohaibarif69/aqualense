# Where the app gets its data: "mock" (built-in demo data, default), "supabase", or "http" (custom API).
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase (only used when NEXT_PUBLIC_DATA_SOURCE=supabase)
# Dashboard → Project Settings → API. Use the anon/public key — NEVER the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PHOTO_BUCKET=observation-photos

# Custom HTTP API (only used when NEXT_PUBLIC_DATA_SOURCE=http)
NEXT_PUBLIC_API_BASE_URL=

# AI photo check + analysis: "gemini" (Google Gemini) or "mock" (offline demo stub).
NEXT_PUBLIC_AI_PROVIDER=gemini

# Server-only (no NEXT_PUBLIC_ prefix, so it is never sent to the browser).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-side role check (CSV export, sensors). /api/session signs a role cookie with this secret.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
# true  = demo: anyone can pick any role from the profile menu.
# false = secure mode: reviewer / researcher / admin need the passcodes below (citizens never do).
DEMO_ROLE_SWITCH=true
# Passcodes used when DEMO_ROLE_SWITCH=false. Use long random values (openssl rand -base64 24). Leave a role blank to switch it off.
ROLE_PASSCODE_EXPERT=
ROLE_PASSCODE_RESEARCHER=
ROLE_PASSCODE_ADMIN=

# Sensors: "simulated" (demo probes in the browser, default) or "server" (registry + readings stored on the server).
NEXT_PUBLIC_SENSOR_SOURCE=simulated
# Devices and gauge loaders send data with:  Authorization: Bearer <INGEST_API_KEY>  (openssl rand -hex 32). Blank = ingest off.
INGEST_API_KEY=
# Server storage for sensors/measurements. Default: JSON file in ./.data (set DATA_DIR to move it). With
# NEXT_PUBLIC_DATA_SOURCE=supabase it uses Supabase instead and needs the service-role key below (server only, NEVER NEXT_PUBLIC_).
DATA_DIR=
SUPABASE_SERVICE_ROLE_KEY=

# Durable rate limiting (free tier at upstash.com). Without these, limits are per-instance memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_MAX_UPLOAD_MB=10
NEXT_PUBLIC_FEATURE_VOICE=false
